# ==============================================================================
# Telegram Trend & Pain-Point Radar (.env.example)
# Copy this file to .env and fill in the values
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_radar?schema=public"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# LLM Provider (Anthropic Claude or OpenAI-compatible)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
LLM_MODEL="claude-3-5-haiku-latest"

# Worker & Scheduler Configuration
SCRAPE_INTERVAL_HOURS=12
DIGEST_SLOT_1_UTC=4   # e.g., 09:00 Tashkent time (UTC+5) = 04:00 UTC
DIGEST_SLOT_2_UTC=15  # e.g., 20:00 Tashkent time (UTC+5) = 15:00 UTC

# Admin Dashboard
ADMIN_PASSWORD="super_secret_admin_password_change_me"
NEXTAUTH_SECRET="random_generated_secret_string"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
LOG_LEVEL="info"
